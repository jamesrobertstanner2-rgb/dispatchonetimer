# Copy this file to .env and replace every CHANGE_ME value.
PORT=3000
NODE_ENV=development

# Use a long, random value. Do not share it or commit .env.
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# The first owner account is created from these values on first startup.
OWNER_USERNAME=owner
OWNER_PASSWORD=CHANGE_ME_TO_A_LONG_PASSWORD
